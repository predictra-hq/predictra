# =============================================================================
# PREDICTRA — variabili d'ambiente (SOLO nomi e descrizioni, MAI valori reali)
# =============================================================================
# Locale: copiare in apps/web/.env.local (ignorato da git) e compilare.
# Vercel: Project → Settings → Environment Variables (separate per Preview/Production).
# GitHub Actions: Settings → Secrets and variables → Actions.
#
# Regola: le chiavi privilegiate NON devono mai avere il prefisso NEXT_PUBLIC_.

# --- Supabase (pubbliche, esposte al browser) --------------------------------
# URL del progetto: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Chiave "publishable" (sb_publishable_...) o, sui progetti legacy, la "anon key".
# È pensata per il browser: la sicurezza dei dati è garantita dalle policy RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SOLO server) ---------------------------------------------------
# Chiave "secret" (sb_secret_...) o, sui progetti legacy, la "service_role key".
# Bypassa RLS: usata solo lato server per link di invito/reset, sospensioni e rate limiting.
SUPABASE_SECRET_KEY=

# --- Applicazione -------------------------------------------------------------
# URL pubblico dell'app, senza slash finale (es. http://localhost:3000 in locale).
# La pipeline lo imposta anche come Site URL di Supabase Auth (secret DEV_APP_BASE_URL).
APP_BASE_URL=

# --- M2 — data collector (services/data-collector, solo per l'uso in locale) ----
# In GitHub Actions: segreti FOOTBALL_DATA_API_KEY, DEV_SUPABASE_PROJECT_ID, DEV_SUPABASE_SECRET_KEY.
# FOOTBALL_DATA_API_KEY=   # chiave football-data.org (piano Free)
# SUPABASE_URL=            # https://<ref>.supabase.co (in alternativa usa NEXT_PUBLIC_SUPABASE_URL)

# --- Milestone successive (non ancora usate: NON compilare) -------------------
# API_FOOTBALL_KEY=        # M2 — API-Football (backfill storico)
# ODDS_API_KEY=            # M3 — The Odds API
# QSTASH_TOKEN=            # M7 — Upstash QStash (scheduler)
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# DATABASE_URL=            # M7 — worker Python / backup pg_dump (solo GitHub Secrets)

# --- Pipeline (SOLO GitHub Secrets, mai in .env) — vedi docs/operations/setup.md §3 ---
# SUPABASE_ACCESS_TOKEN, DEV_SUPABASE_PROJECT_ID, DEV_SUPABASE_DB_PASSWORD, DEV_APP_BASE_URL,
# VERCEL_TOKEN, VERCEL_ORG_ID, DEV_VERCEL_PROJECT_ID (+ PROD_* per la produzione)
